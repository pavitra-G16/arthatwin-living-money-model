# Frontend (build-time)
NEXT_PUBLIC_API_URL=https://arthatwin-living-money-model.onrender.com/api
NEXT_PUBLIC_ARTHATWIN_PUBLIC_DEMO=1

# Backend (set secrets only in the hosting provider; never commit real values)
ARTHATWIN_PUBLIC_DEMO=1
SEED_SYNTHETIC_DEMO_ON_START=1
DEMO_RESET_TOKEN=replace-with-a-long-random-secret
CORS_ALLOWED_ORIGINS=https://arthatwin-living-money-model-2.onrender.com
# Optional; configure a durable managed database before collecting any real data.
# DATABASE_URL=postgresql://user:password@host/database
# Optional Gemini function-calling coach. Disabled unless explicitly enabled, keyed, and consented to per question.
# Gemini receives only the question and selected month for tool choice; financial data/tools remain local.
# Provider/tool failures use the deterministic coach fallback.
# EXTERNAL_AI_ENABLED=0
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_API_KEY=
